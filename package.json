{
  "name": "frontedge",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "pnpm --filter @frontedge/spike dev",
    "build": "pnpm --filter @frontedge/spike build",
    "build:ui": "pnpm build && node scripts/copy-ui.mjs",
    "gen:types": "uv run --package frontedge frontedge gen --out packages/ui/src/generated",
    "demo": "uv run --package frontedge-demo-ml demo-ml",
    "typecheck": "pnpm -r typecheck",
    "check:contrast": "node packages/ui/scripts/check-contrast.mjs",
    "check:contrast:dark": "node packages/ui/scripts/check-contrast.mjs --theme dark"
  }
}
