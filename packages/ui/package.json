{
  "name": "@frontedge/ui",
  "version": "0.1.0",
  "description": "Design system and ML interface patterns for the frontedge frontend layer: runs, metrics, evals and datasets",
  "keywords": [
    "ml",
    "mlops",
    "design-system",
    "react",
    "frontend",
    "dashboard",
    "runs",
    "experiments"
  ],
  "license": "MIT",
  "author": "socrabs151",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/socrabs151/frontedge-ml.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/socrabs151/frontedge-ml#readme",
  "bugs": {
    "url": "https://github.com/socrabs151/frontedge-ml/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./src/styles/index.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src/styles",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.1.0",
    "@radix-ui/react-dropdown-menu": "^2.1.0",
    "@radix-ui/react-popover": "^1.1.0",
    "@radix-ui/react-select": "^2.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-tooltip": "^1.1.0",
    "@tanstack/react-table": "^8.20.0",
    "@tanstack/react-virtual": "^3.10.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.460.0"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.1.0",
    "@fontsource/jetbrains-mono": "^5.1.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsdown": "^0.15.0",
    "typescript": "^5.7.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
